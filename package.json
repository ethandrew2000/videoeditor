{
  "name": "framewave-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based video and audio editor with a Windows desktop package.",
  "scripts": {
    "start": "npm run build && python3 serve.py",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build:windows": "tauri icon src-tauri/icons/framewave.svg && tauri build --bundles nsis",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "signalsmith-stretch": "^1.3.2"
  }
}
